# PolicyPilot Environment Configuration (.env)
# Copy to .env for local development or set as environment variables in Render/Vercel.

# Environment & Demo Mode
# APP_ENV: "production" | "development" (default: "production")
# DEMO_MODE: "true" | "false"
# In production, DEMO_MODE defaults to "true" (read-only admin, mutating routes blocked with 403).
# In development, DEMO_MODE defaults to "false" (full admin upload/delete/reindex permitted).
APP_ENV=development
DEMO_MODE=false

# Admin Portal Password
# In production, this must be >=12 characters and not a known placeholder, regardless of DEMO_MODE.
ADMIN_PASSWORD=change_this_to_a_secure_password_min_12_chars

# Primary LLM & Embeddings Provider (gemini | openai | anthropic)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LLM_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-flash-lite-latest
GEMINI_JUDGE_MODEL=gemini-flash-lite-latest
EMBEDDINGS_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional Alternative Providers
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

ANTHROPIC_API_KEY=
ANTHROPIC_LLM_MODEL=claude-3-5-haiku-20241022

# Retrieval Parameters & Thresholds
RETRIEVAL_SIMILARITY_THRESHOLD=0.55
TOP_K_RETRIEVAL=5
RRF_K=60

# Upload & Input Limits
MAX_UPLOAD_SIZE_BYTES=52428800
MAX_QUESTION_LENGTH=1500

# Rate Limiting & Proxy Configuration
# RATE_LIMIT_PER_MINUTE: maximum requests per client IP per minute
# DAILY_REQUEST_CAP: in-memory global daily demo quota (resets at UTC midnight)
# TRUSTED_PROXIES: comma-separated list of trusted upstream proxy IPs (e.g. Render/Cloudflare)
RATE_LIMIT_PER_MINUTE=30
DAILY_REQUEST_CAP=500
TRUSTED_PROXIES=127.0.0.1,::1

# Branding & CORS
COMPANY_NAME=Northwind Labs
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage Paths
SQLITE_DB_PATH=data/policypilot.db
CHROMA_PERSIST_DIR=data/chroma
SAMPLE_DOCS_DIR=sample_docs

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
