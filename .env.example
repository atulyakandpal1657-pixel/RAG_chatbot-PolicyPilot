# PolicyPilot Configuration
# Model names verified against: https://ai.google.dev/gemini-api/docs/models

# Primary LLM & Embeddings Provider (gemini | openai | anthropic)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
# Verified active Flash model (Oct 2026) - check https://ai.google.dev/gemini-api/docs/models for updates
GEMINI_LLM_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-flash-lite-latest
GEMINI_JUDGE_MODEL=gemini-3.6-flash
EMBEDDINGS_PROVIDER=gemini
# Verified active embedding model
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional Alternative Providers
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

ANTHROPIC_API_KEY=
ANTHROPIC_LLM_MODEL=claude-3-5-haiku-20241022

# Retrieval Parameters & Fallback Threshold
# RETRIEVAL_SIMILARITY_THRESHOLD: raw vector cosine similarity of the best chunk.
# Below this threshold, Layer-1 fallback fires immediately (before LLM call).
# Tuned on 10-question dev split; validated on 20-question test split.
RETRIEVAL_SIMILARITY_THRESHOLD=0.55
TOP_K_RETRIEVAL=5
RRF_K=60

# Admin Portal Authentication
ADMIN_PASSWORD=change_this_to_a_secure_password

# Storage Paths
SQLITE_DB_PATH=data/policypilot.db
CHROMA_PERSIST_DIR=data/chroma
SAMPLE_DOCS_DIR=sample_docs
